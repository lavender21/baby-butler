{
  "name": "baby-butler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "kill-port 3001 || true",
    "dev": "concurrently \"npm run dev:api\" \"vite\"",
    "dev:api": "node server/index.js",
    "migrate": "node server/db/migrate.js",
    "db:backup": "node server/db/backup.js",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "express": "^5.2.1",
    "pinia": "^3.0.4",
    "vant": "^4.9.24",
    "vue": "^3.4.37",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.1",
    "vue-tsc": "^2.2.12"
  }
}
